# Xcode local user data
BriefShow.xcodeproj/xcuserdata/

# Build/package outputs
build/
dist/

# macOS
.DS_Store

# Alternate derived-data output from xcodebuild -derivedDataPath (392 MB).
# dist-universal/ is deliberately NOT here: it is already tracked (a shipped
# build), and listing it would only look like it was ignored.
build_dd/

# The other derived-data output. Was TRACKED by accident — 327 files and
# 214 MB of compilation cache, object files and a built .app going up with
# every push. Nothing of the client's is in it (checked: no photos, no
# layers, no edits — those live in UserDefaults and never reach the repo),
# but a release push should carry the app's SOURCE, not one machine's build
# cache.
build_universal/

# Core ML weights. Not a preference: GitHub rejects any single file over
# 100 MB, and SD's UNet alone is 1.6 GB. LaMa's is 97 MB — under the limit
# today, over it after any reconversion. CoreMLModels/convert_lama.py rebuilds
# LaMa from the published weights; see BRIEFSHOW_DEVELOP_NOTES.md for SD.
BriefShow/*.mlpackage/
BriefShow/*.mlmodelc/
